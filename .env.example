# =================================================================
# KANHA CONSTRUCTION & INTERIOR - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port (Default: 3000 locally, dynamically assigned on Render/Vercel)
PORT=3000

# Admin Access Credentials
# Default PIN is 1234 or kanha@admin2026
ADMIN_PASSWORD=kanha@admin2026
SESSION_SECRET=kanha_secure_admin_jwt_hmac_secret_2026

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# By default, Kanha Portfolio automatically uses a resilient, high-speed
# Local Persistent JSON database (stored in /data/portfolio-db.json).
#
# To connect to MongoDB Atlas (Free Cloud Cluster):
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Under Database Access, create a database user and password.
# 3. Under Network Access, allow access from anywhere (0.0.0.0/0).
# 4. Copy your connection string and paste below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kanha_portfolio?retryWrites=true&w=majority

# =================================================================
# CLOUD IMAGE STORAGE (CLOUDINARY) - OPTIONAL
# =================================================================
# By default, uploaded images are stored permanently on disk under /uploads/.
# To host all uploaded portfolio and gallery photos on Cloudinary CDN for free:
# 1. Sign up for a free account at https://cloudinary.com/
# 2. Obtain your Cloud Name, API Key, and API Secret from Dashboard:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# =================================================================
# EMAIL NOTIFICATIONS (NODEMAILER)
# =================================================================
# Target email receiving inquiries: kanha.consinterio@gmail.com
# To send emails via Gmail SMTP, create a Google App Password:
# GMAIL_USER=kanha.consinterio@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password
