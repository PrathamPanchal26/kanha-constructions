{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Get In Touch Directly</span>
      <h1 class="page-hero-title">Contact Kanha Construction & Interior</h1>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto;">
        Have a plot, villa, industrial shed, or interior design project in Ahmedabad? Connect directly via WhatsApp or call our lead engineers for an instant consultation and free site visit.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section" style="padding: 70px 0;">
    <div class="container">
      <div class="contact-grid">
        
        <!-- Contact Cards -->
        <div class="contact-card-info">
          <h3 style="font-size: 1.5rem; color: #fff; margin-bottom: 20px;">Direct Contact Information</h3>

          <!-- Prominent WhatsApp Card (Replaced Email as requested) -->
          <div class="contact-item whatsapp-contact-highlight" style="border: 1px solid rgba(37, 211, 102, 0.4); background: rgba(37, 211, 102, 0.08); padding: 18px; border-radius: 12px; transition: all 0.3s ease;">
            <div class="contact-icon" style="background: #25d366; color: #fff; font-size: 1.4rem;">
              <i class="fa-brands fa-whatsapp"></i>
            </div>
            <div class="contact-details">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <h4 style="color: #25d366; margin: 0;">WhatsApp Direct Chat</h4>
                <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.72rem; font-weight: 700; color: #25d366; background: rgba(37, 211, 102, 0.2); padding: 2px 8px; border-radius: 12px;">
                  <span style="width: 6px; height: 6px; border-radius: 50%; background: #25d366; display: inline-block;"></span> Active Now
                </span>
              </div>
              <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Construction%20%26%20Interior%2C%20I%20would%20like%20to%20discuss%20a%20project!" target="_blank" rel="noopener" style="color: #25d366; font-size: 1.15rem; font-weight: 700; display: inline-block;">
                +91 9898749575
              </a>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">
                Instant reply • Share floor plans, elevation photos & get free cost estimation
              </p>
            </div>
          </div>

          <!-- Phone Number -->
          <div class="contact-item">
            <div class="contact-icon"><i class="fa-solid fa-phone"></i></div>
            <div class="contact-details">
              <h4>Direct Phone Call</h4>
              <a href="tel:{{phone}}">{{phone}}</a>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
                Monday - Saturday, 9:00 AM - 7:00 PM IST
              </p>
            </div>
          </div>

          <!-- Headquarters Location -->
          <div class="contact-item">
            <div class="contact-icon"><i class="fa-solid fa-location-dot"></i></div>
            <div class="contact-details">
              <h4>Headquarters & Design Studio</h4>
              <p>{{address}}</p>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
                Near Shreenath Party Plot, Nikol, Ahmedabad - 382350
              </p>
            </div>
          </div>

          <!-- Office Working Hours -->
          <div style="background: rgba(7, 25, 34, 0.6); padding: 20px; border-radius: 12px; border: 1px solid var(--border-light); margin-top: 10px;">
            <h4 style="color: #fff; font-size: 1rem; margin-bottom: 6px;"><i class="fa-solid fa-business-time" style="color: var(--accent-cyan);"></i> Consultation Timings</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Office: Mon - Sat (9:00 AM - 7:00 PM IST)</p>
            <p style="font-size: 0.82rem; color: #25d366; margin-top: 6px; font-weight: 600;">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp inquiries open 24/7
            </p>
          </div>
        </div>

        <!-- Inquiry Form -->
        <form id="contactForm" style="background: var(--bg-card); padding: 40px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-main);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
            <div>
              <h3 style="font-size: 1.5rem; color: #fff; margin-bottom: 4px;">Send Project Inquiry</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);">Direct connection to WhatsApp for fastest response</p>
            </div>
            <span style="background: rgba(37, 211, 102, 0.15); color: #25d366; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
              <i class="fa-brands fa-whatsapp"></i> Fast Connect
            </span>
          </div>
          
          <div class="form-group">
            <label for="contactName">Your Full Name *</label>
            <input type="text" id="contactName" class="form-control" placeholder="e.g. Rajesh Patel" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
              <label for="contactPhone">Phone / WhatsApp Number *</label>
              <input type="tel" id="contactPhone" class="form-control" placeholder="+91 98987XXXXX" required>
            </div>

            <div class="form-group">
              <label for="contactCategory">Requirement Type</label>
              <select id="contactCategory" class="form-control" style="color:#fff; background: var(--bg-dark);">
                <option value="Turnkey Project (Civil + Interior)">Turnkey Project (Civil + Interior)</option>
                <option value="Residential Villa / Bungalow">Residential Villa / Bungalow</option>
                <option value="Industrial Shed / Plant">Industrial Shed / Plant</option>
                <option value="Luxury Interior Design">Luxury Interior Design</option>
                <option value="Hospital / Clinic Interior">Hospital / Clinic Interior</option>
                <option value="Architectural 3D Elevation & Planning">Architectural 3D Elevation & Planning</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="contactMessage">Project Details / Location / Plot Area *</label>
            <textarea id="contactMessage" class="form-control" placeholder="Describe your site location in Ahmedabad, plot area (sq. ft.), or design ideas..." required></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; background: #25d366; border-color: #25d366; font-size: 1.05rem; padding: 15px 24px; box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);">
            Send Inquiry via WhatsApp <i class="fa-brands fa-whatsapp" style="font-size: 1.3rem;"></i>
          </button>
        </form>

      </div>

      <!-- Service Areas Tag Cloud -->
      <div style="margin-top: 40px; background: rgba(7, 25, 34, 0.7); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 24px;">
        <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-map-pin" style="color: var(--accent-cyan);"></i> Areas We Serve Across Ahmedabad & Gujarat:
        </h4>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Nikol</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Naroda</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Vatva GIDC</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Bopal</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">South Bopal</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Vastral</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Odhav</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Chiloda</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Kuha</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">SG Highway</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Science City</span>
          <span style="background: var(--bg-card); border: 1px solid var(--border-light); padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; color: #fff;">Gandhinagar</span>
        </div>
      </div>

      <!-- Interactive Google Maps Location Section -->
      <div style="margin-top: 40px; background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); overflow: hidden; padding: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <div>
            <span style="color: var(--accent-cyan); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 4px;">
              <i class="fa-solid fa-map-location-dot"></i> Live Map Location
            </span>
            <h3 style="font-size: 1.6rem; color: #fff; margin: 0;">Kanha Construction and Interior</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 4px;">Nikol, Ahmedabad, Gujarat, India (Near Shreenath Party Plot)</p>
          </div>

          <a href="https://www.google.com/maps/search/?api=1&query=Kanha+Construction+and+Interior+Nikol+Ahmedabad" target="_blank" rel="noopener" class="btn-primary" style="padding: 10px 22px; font-size: 0.85rem;">
            Open in Google Maps <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
        </div>

        <div style="width: 100%; height: 420px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-light);">
          <iframe 
            src="https://maps.google.com/maps?q=Kanha%20Construction%20and%20Interior%20Nikol%20Ahmedabad&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>

    </div>
  </section>

{{> partials/footer}}
