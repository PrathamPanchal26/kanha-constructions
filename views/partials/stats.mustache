  <!-- Stats Ribbon -->
  <section class="stats-ribbon">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <h3 id="statProjectsDelivered">{{stats.projectsDelivered}}</h3>
          <p>Projects Delivered</p>
        </div>
        <div class="stat-item">
          <h3 id="statLargestSqFt">{{stats.largestSqFt}}</h3>
          <p>Largest Sq. Ft. Facility</p>
        </div>
        <div class="stat-item">
          <h3 id="statOnTimeExecution">{{stats.onTimeExecution}}</h3>
          <p>On-Time Execution</p>
        </div>
        <div class="stat-item">
          <h3 id="statSpecializations">{{stats.specializations}}</h3>
          <p>Core Specializations</p>
        </div>
      </div>
    </div>
  </section>
