{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Established Since {{establishedYear}} • {{location}}</span>
      <h1 class="page-hero-title">About Our Company</h1>
      <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
        Delivering quality-driven projects with a commitment to excellence, innovation, and structural durability.
      </p>
    </div>
  </section>

  {{> partials/stats}}

  <!-- Detailed About Story Section -->
  <section class="about-section about-section-page">
    <div class="container">
      <div class="about-card about-story-card">
        <div class="about-content">
          <span class="about-journey-tag">Our Journey</span>
          <h2 class="dyn-about-subtitle about-heading">Combining Functionality, Aesthetics, and Durability</h2>
          <p class="dyn-about-story1 about-text">
            Kanha Construction and Interior is a trusted name in the field of construction and interior solutions. Founded in {{establishedYear}} in Nikol, Ahmedabad, we specialize in residential, commercial, industrial, hospital, and interior works, offering end-to-end solutions that combine functionality, aesthetics, and durability.
          </p>
          <p class="dyn-about-story2 about-text">
            Our team of structural engineers, architects, interior designers, and project managers work cohesively to deliver seamless turnkey solutions from raw site development to move-in ready handovers.
          </p>
          
          <div class="about-features-grid">
            <div class="about-feature-box">
              <div class="feature-icon-wrap">
                <i class="fa-solid fa-shield-halved"></i>
              </div>
              <div class="feature-info">
                <h4>Safety Standards</h4>
                <p>Strict structural safety compliance and load calculations.</p>
              </div>
            </div>
            <div class="about-feature-box">
              <div class="feature-icon-wrap">
                <i class="fa-solid fa-clock"></i>
              </div>
              <div class="feature-info">
                <h4>On-Time Handover</h4>
                <p>Structured project timelines with milestone updates.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="about-image-wrapper">
          <picture>
            <source srcset="/assets/images/kanha_hero_facade_1791296928268-768w.webp 768w, /assets/images/kanha_hero_facade_1791296928268.webp 1376w" sizes="(max-width: 768px) 100vw, 600px" type="image/webp">
            <source srcset="/assets/images/kanha_hero_facade_1791296928268-768w.jpg 768w, /assets/images/kanha_hero_facade_1791296928268.jpg 1376w" sizes="(max-width: 768px) 100vw, 600px" type="image/jpeg">
            <img src="/assets/images/kanha_hero_facade_1791296928268.jpg" alt="Kanha Architecture Facade" class="dyn-about-img about-img" width="1376" height="768" loading="lazy" decoding="async" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </picture>
        </div>
      </div>

      <!-- Core Values -->
      <div class="section-header about-values-header">
        <span class="section-subtitle">Our Principles</span>
        <h2 class="section-title">What Sets Us Apart</h2>
      </div>

      <div class="about-values-grid">
        <div class="about-value-card">
          <div class="value-icon-wrap icon-cyan">
            <i class="fa-solid fa-award"></i>
          </div>
          <h3>Excellence & Reliability</h3>
          <p>Every foundation, pillar, and interior finish is executed with precision engineering and high-grade materials.</p>
        </div>

        <div class="about-value-card">
          <div class="value-icon-wrap icon-teal">
            <i class="fa-solid fa-lightbulb"></i>
          </div>
          <h3>Modern Innovation</h3>
          <p>Integrating contemporary 3D architectural rendering, smart lighting, and passive solar elevation concepts.</p>
        </div>

        <div class="about-value-card">
          <div class="value-icon-wrap icon-gold">
            <i class="fa-solid fa-handshake"></i>
          </div>
          <h3>Client Transparency</h3>
          <p>Clear budget estimations, no hidden costs, and comprehensive turnkey management from start to finish.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="about-cta-banner">
    <div class="container">
      <h2>Ready to Build Your Dream Space?</h2>
      <p>Let our team assist you with turnkey architectural and interior solutions.</p>
      <div class="about-cta-actions">
        <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20would%20like%20to%20discuss%20a%20turnkey%20project." target="_blank" rel="noopener" class="btn-primary" style="background: #25d366; border-color: #25d366; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);">
          <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i> Chat on WhatsApp
        </a>
        <a href="/contact" class="btn-secondary">
          Contact Details <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

{{> partials/footer}}
