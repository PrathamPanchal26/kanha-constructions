{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Established Since {{establishedYear}} • {{location}}</span>
      <h1 class="page-hero-title">About Our Company</h1>
      <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
        Delivering quality-driven projects with a commitment to excellence, innovation, and structural durability.
      </p>
    </div>
  </section>

  {{> partials/stats}}

  <!-- Detailed About Story Section -->
  <section style="padding: 80px 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; background: var(--bg-surface); padding: 48px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); margin-bottom: 60px;">
        <div>
          <span style="color: var(--accent-cyan); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px;">Our Journey</span>
          <h2 style="font-size: 2.2rem; color: #fff; margin: 10px 0 20px;">Combining Functionality, Aesthetics, and Durability</h2>
          <p style="color: var(--text-muted); line-height: 1.8; margin-bottom: 20px;">
            Kanha Construction and Interior is a trusted name in the field of construction and interior solutions. Founded in {{establishedYear}} in Nikol, Ahmedabad, we specialize in residential, commercial, industrial, hospital, and interior works, offering end-to-end solutions that combine functionality, aesthetics, and durability.
          </p>
          <p style="color: var(--text-muted); line-height: 1.8; margin-bottom: 24px;">
            Our team of structural engineers, architects, interior designers, and project managers work cohesively to deliver seamless turnkey solutions from raw site development to move-in ready handovers.
          </p>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div style="background: rgba(7, 25, 34, 0.6); padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
              <i class="fa-solid fa-shield-halved" style="font-size: 24px; color: var(--accent-cyan); margin-bottom: 10px;"></i>
              <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 6px;">Safety Standards</h4>
              <p style="font-size: 0.85rem; color: var(--text-muted);">Strict structural safety compliance and load calculations.</p>
            </div>
            <div style="background: rgba(7, 25, 34, 0.6); padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
              <i class="fa-solid fa-clock" style="font-size: 24px; color: var(--accent-teal); margin-bottom: 10px;"></i>
              <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 6px;">On-Time Handover</h4>
              <p style="font-size: 0.85rem; color: var(--text-muted);">Structured project timelines with milestone updates.</p>
            </div>
          </div>
        </div>

        <div>
          <img src="/assets/images/kanha_hero_facade_1791296928268.jpg" alt="Kanha Architecture Facade" style="width: 100%; border-radius: 16px; border: 1px solid var(--border-light); box-shadow: var(--shadow-main);" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
        </div>
      </div>

      <!-- Core Values -->
      <div style="text-align: center; margin-bottom: 40px;">
        <span class="section-subtitle">Our Principles</span>
        <h2 class="section-title">What Sets Us Apart</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        <div style="background: var(--bg-card); padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
          <div style="width: 50px; height: 50px; background: rgba(56, 189, 248, 0.12); color: var(--accent-cyan); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 20px;">
            <i class="fa-solid fa-award"></i>
          </div>
          <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 12px;">Excellence & Reliability</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Every foundation, pillar, and interior finish is executed with precision engineering and high-grade materials.</p>
        </div>

        <div style="background: var(--bg-card); padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
          <div style="width: 50px; height: 50px; background: rgba(20, 184, 166, 0.12); color: var(--accent-teal); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 20px;">
            <i class="fa-solid fa-lightbulb"></i>
          </div>
          <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 12px;">Modern Innovation</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Integrating contemporary 3D architectural rendering, smart lighting, and passive solar elevation concepts.</p>
        </div>

        <div style="background: var(--bg-card); padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
          <div style="width: 50px; height: 50px; background: rgba(234, 179, 8, 0.12); color: var(--accent-gold); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 20px;">
            <i class="fa-solid fa-handshake"></i>
          </div>
          <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 12px;">Client Transparency</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Clear budget estimations, no hidden costs, and comprehensive turnkey management from start to finish.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="background: linear-gradient(135deg, var(--bg-surface), #081d26); padding: 60px 0; border-y: 1px solid var(--border-light); text-align: center;">
    <div class="container">
      <h2 style="font-size: 2rem; color: #fff; margin-bottom: 16px;">Ready to Build Your Dream Space?</h2>
      <p style="color: var(--text-muted); margin-bottom: 24px;">Let our team assist you with turnkey architectural and interior solutions.</p>
      <a href="/contact" class="btn-primary">
        Contact Our Experts <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

{{> partials/footer}}
