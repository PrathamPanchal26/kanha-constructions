{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Comprehensive Architectural & Engineering Solutions in Ahmedabad</span>
      <h1 class="page-hero-title">Our Construction & Interior Services</h1>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto;">
        From 3D architectural elevation design and seismic structural engineering to full turnkey residential villa builds and luxury interiors across Ahmedabad and Gujarat.
      </p>
    </div>
  </section>

  <!-- Detailed Services Grid -->
  <section class="services-detail-section">
    <div class="container">
      <div id="detailedServicesGrid" class="services-detail-list">

        {{#servicesList}}
        <div class="service-detail-card {{#isReversed}}is-reversed{{/isReversed}}">
          <div class="service-detail-content">
            <div class="service-detail-icon-wrap">
              <i class="{{icon}}"></i>
            </div>
            <h2 class="service-detail-title">{{title}}</h2>
            <p class="service-detail-desc">
              {{fullDescription}}
            </p>

            <ul class="service-detail-highlights">
              {{#highlights}}
              <li><i class="fa-solid fa-check"></i> <span>{{.}}</span></li>
              {{/highlights}}
            </ul>

            <div class="service-detail-actions" style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
              <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20want%20to%20inquire%20about%20{{title}}%20services." target="_blank" rel="noopener" class="btn-primary" style="background: #25d366; border-color: #25d366; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);">
                Inquire on WhatsApp <i class="fa-brands fa-whatsapp"></i>
              </a>
              <a href="/contact" class="btn-secondary">Free Consultation <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>

          <div class="service-detail-img-wrap">
            <img src="{{image}}" alt="{{title}} Kanha Construction Ahmedabad" class="service-detail-img" loading="lazy" decoding="async" width="1376" height="768" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </div>
        </div>
        {{/servicesList}}

      </div>
    </div>
  </section>

  <!-- Specialized Construction Capabilities & Keyword Rich Disciplines -->
  <section style="padding: 60px 0; background: var(--bg-dark-card); border-top: 1px solid var(--border-light);">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Our Expertise & Engineering Standards</span>
        <h2 class="section-title">Specialized Construction & Interior Disciplines</h2>
        <p class="section-desc">Why Kanha Construction is ranked among the top building contractors and interior designers in Ahmedabad.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 36px;">
        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: var(--accent-cyan); font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-building-shield"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">Seismic-Resilient RCC Structures</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            IS 456 and IS 1893 seismic code compliance for Zone 3 & 4 earthquake safety. Heavy-duty column-beam frameworks, soil bearing pressure testing, and foundation waterproofing.
          </p>
        </div>

        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: var(--accent-gold); font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-industry"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">Industrial PEB Sheds & Warehouses</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            Pre-Engineered Building (PEB) solutions, high-span steel trusses, gantry crane beams, and heavy industrial flooring across Vatva, Odhav, and Kathwada GIDC.
          </p>
        </div>

        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: #25d366; font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-house-chimney-window"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">Turnkey Villa & Bungalow Construction</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            Single-point turnkey accountability from raw plot excavation to exterior 3D elevations, plumbing, electrical, vitrified flooring, and final key handover in Nikol & Bopal.
          </p>
        </div>

        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: #38bdf8; font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-couch"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">Luxury Interior Styling & Fit-Outs</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            Custom acrylic modular kitchens, Italian marble wall panelling, ambient false ceilings, bespoke TV units, and hospital/clinic healthcare interior architecture.
          </p>
        </div>

        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: #a855f7; font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-compass-drafting"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">3D Architectural & Municipal Sanctions</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            Photorealistic exterior elevations, 2D floor plans, spatial zoning, and compliant structural working drawings prepared for AMC and AUDA building approvals.
          </p>
        </div>

        <div style="background: var(--bg-card); padding: 30px; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
          <div style="color: #f59e0b; font-size: 2rem; margin-bottom: 16px;">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>
          <h3 style="font-size: 1.25rem; color: #fff; margin-bottom: 12px;">Transparent BOQ & Fixed Pricing</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
            Itemized Bill of Quantities (BOQ), verified grade materials (Ultratech/Ambuja cement, Tata/Jindal steel), with zero hidden costs or midway budget shocks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner to WhatsApp -->
  <section class="services-bottom-cta">
    <div class="container">
      <h2 class="services-cta-heading">Need a Tailored Quotation for Your Project?</h2>
      <p class="services-cta-desc">Share your plot dimensions or architectural drawings directly on WhatsApp for an instant BOQ estimate.</p>
      <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20have%20plot%20dimensions%20and%20need%20a%20project%20quotation." target="_blank" rel="noopener" class="btn-primary btn-services-cta">
        <i class="fa-brands fa-whatsapp"></i> WhatsApp Us Directly (+91 9898749575)
      </a>
    </div>
  </section>

{{> partials/footer}}
