{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Comprehensive Architectural & Engineering Solutions</span>
      <h1 class="page-hero-title">Our Services</h1>
      <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
        From initial architectural design concepts to complete turnkey construction, we offer end-to-end expertise.
      </p>
    </div>
  </section>

  <!-- Detailed Services Grid -->
  <section style="padding: 80px 0;">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 40px;">

        {{#servicesList}}
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;">
          <div {{#isReversed}}style="order: 2;"{{/isReversed}}>
            <div style="width: 54px; height: 54px; background: rgba(56, 189, 248, 0.15); color: var(--accent-cyan); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 20px;">
              <i class="{{icon}}"></i>
            </div>
            <h2 style="font-size: 2rem; color: #fff; margin-bottom: 14px;">{{title}}</h2>
            <p style="color: var(--text-muted); line-height: 1.8; margin-bottom: 20px;">
              {{fullDescription}}
            </p>

            <ul style="list-style: none; color: var(--text-main); display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px;">
              {{#highlights}}
              <li style="display: flex; align-items: center; gap: 10px;"><i class="fa-solid fa-check" style="color: var(--accent-cyan);"></i> {{.}}</li>
              {{/highlights}}
            </ul>

            <a href="/contact" class="btn-primary">Inquire for {{title}} <i class="fa-solid fa-arrow-right"></i></a>
          </div>

          <div {{#isReversed}}style="order: 1;"{{/isReversed}}>
            <img src="{{image}}" alt="{{title}}" style="width: 100%; border-radius: 16px; border: 1px solid var(--border-light);" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </div>
        </div>
        {{/servicesList}}

      </div>
    </div>
  </section>

{{> partials/footer}}
