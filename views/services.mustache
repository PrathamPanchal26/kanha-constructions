{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Comprehensive Architectural & Engineering Solutions</span>
      <h1 class="page-hero-title">Our Services</h1>
      <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
        From initial architectural design concepts to complete turnkey construction, we offer end-to-end expertise.
      </p>
    </div>
  </section>

  <!-- Detailed Services Grid -->
  <section class="services-detail-section">
    <div class="container">
      <div id="detailedServicesGrid" class="services-detail-list">

        {{#servicesList}}
        <div class="service-detail-card {{#isReversed}}is-reversed{{/isReversed}}">
          <div class="service-detail-content">
            <div class="service-detail-icon-wrap">
              <i class="{{icon}}"></i>
            </div>
            <h2 class="service-detail-title">{{title}}</h2>
            <p class="service-detail-desc">
              {{fullDescription}}
            </p>

            <ul class="service-detail-highlights">
              {{#highlights}}
              <li><i class="fa-solid fa-check"></i> <span>{{.}}</span></li>
              {{/highlights}}
            </ul>

            <div class="service-detail-actions">
              <a href="/contact" class="btn-primary">Inquire for {{title}} <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>

          <div class="service-detail-img-wrap">
            <img src="{{image}}" alt="{{title}}" class="service-detail-img" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </div>
        </div>
        {{/servicesList}}

      </div>
    </div>
  </section>

{{> partials/footer}}
