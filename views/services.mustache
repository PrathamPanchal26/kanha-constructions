{{> partials/header}}

  <!-- Page Banner -->
  <section class="page-hero">
    <div class="container">
      <span class="page-hero-subtitle">Comprehensive Architectural & Engineering Solutions in Ahmedabad</span>
      <h1 class="page-hero-title">Our Construction & Interior Services</h1>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto;">
        From 3D architectural elevation design and seismic structural engineering to full turnkey residential villa builds and luxury interiors across Ahmedabad and Gujarat.
      </p>
    </div>
  </section>

  <!-- Detailed Services Grid -->
  <section class="services-detail-section">
    <div class="container">
      <div id="detailedServicesGrid" class="services-detail-list">

        {{#servicesList}}
        <div class="service-detail-card {{#isReversed}}is-reversed{{/isReversed}}">
          <div class="service-detail-content">
            <div class="service-detail-icon-wrap">
              <i class="{{icon}}"></i>
            </div>
            <h2 class="service-detail-title">{{title}}</h2>
            <p class="service-detail-desc">
              {{fullDescription}}
            </p>

            <ul class="service-detail-highlights">
              {{#highlights}}
              <li><i class="fa-solid fa-check"></i> <span>{{.}}</span></li>
              {{/highlights}}
            </ul>

            <div class="service-detail-actions" style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
              <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20want%20to%20inquire%20about%20{{title}}%20services." target="_blank" rel="noopener" class="btn-primary" style="background: #25d366; border-color: #25d366; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);">
                Inquire on WhatsApp <i class="fa-brands fa-whatsapp"></i>
              </a>
              <a href="/contact" class="btn-secondary">Free Consultation <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>

          <div class="service-detail-img-wrap">
            <img src="{{image}}" alt="{{title}} Kanha Construction Ahmedabad" class="service-detail-img" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </div>
        </div>
        {{/servicesList}}

      </div>
    </div>
  </section>

  <!-- CTA Banner to WhatsApp -->
  <section style="background: var(--bg-surface); padding: 70px 0; border-top: 1px solid var(--border-light); text-align: center;">
    <div class="container">
      <h2 style="font-size: 2.2rem; color: #fff; margin-bottom: 12px;">Need a Tailored Quotation for Your Project?</h2>
      <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 1.05rem;">Share your plot dimensions or architectural drawings directly on WhatsApp for an instant BOQ estimate.</p>
      <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20have%20plot%20dimensions%20and%20need%20a%20project%20quotation." target="_blank" rel="noopener" class="btn-primary" style="background: #25d366; border-color: #25d366; font-size: 1rem; padding: 14px 28px;">
        <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i> WhatsApp Us Directly (+91 9898749575)
      </a>
    </div>
  </section>

{{> partials/footer}}
