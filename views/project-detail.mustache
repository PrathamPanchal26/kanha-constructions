{{> partials/header}}

  <!-- Project Detail Hero Banner -->
  <section class="project-detail-hero" id="projectDetailContainer">
    <div class="container">
      
      <!-- Breadcrumb Navigation -->
      <div style="margin-bottom: 20px; font-size: 0.9rem; color: var(--text-muted);">
        <a href="/projects" style="color: var(--accent-cyan); text-decoration: none; font-weight: 600;">
          <i class="fa-solid fa-arrow-left"></i> Back to All Projects
        </a>
        <span style="margin: 0 8px;">/</span>
        <span id="detailBreadcrumbTitle" style="color: var(--text-main);">Project Details</span>
      </div>

      <div class="project-detail-grid">
        <div>
          <span class="detail-meta-pill" id="detailCategoryBadge">RESIDENTIAL</span>
          <h1 class="detail-hero-title" id="detailTitle">Project Title</h1>
          <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 24px;" id="detailDesc">
            Project Overview Description...
          </p>

          <div class="detail-meta-grid">
            <div class="detail-meta-box">
              <i class="fa-solid fa-location-dot" style="color: var(--accent-cyan);"></i>
              Location: <strong id="detailLocation">AHMEDABAD</strong>
            </div>
            <div class="detail-meta-box">
              <i class="fa-solid fa-ruler-combined" style="color: var(--accent-cyan);"></i>
              Area: <strong id="detailArea">5000 SQ. FT.</strong>
            </div>
            <div class="detail-meta-box">
              <i class="fa-solid fa-layer-group" style="color: var(--accent-cyan);"></i>
              Type: <strong id="detailType">Turnkey Project</strong>
            </div>
          </div>

          <div style="margin-top: 30px; display: flex; gap: 16px; flex-wrap: wrap;">
            <a href="https://wa.me/919898749575?text=Hello%20Kanha%20Team%2C%20I%20am%20interested%20in%20a%20project%20similar%20to%20the%20one%20on%20your%20website." target="_blank" rel="noopener" class="btn-primary" id="btnInquireProject" style="background: #25d366; border-color: #25d366; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);">
              Inquire on WhatsApp <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i>
            </a>
            <a href="/projects" class="btn-secondary">
              Browse Portfolio <i class="fa-solid fa-grid-2"></i>
            </a>
          </div>
        </div>

        <div>
          <div style="border-radius: 20px; overflow: hidden; border: 2px solid var(--border-light); box-shadow: var(--shadow-main);">
            <img id="detailCoverImg" src="" alt="Project Cover" style="width: 100%; height: 380px; object-fit: cover; display: block;" onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'">
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Categorized Project Gallery Section -->
  <section style="padding: 80px 0; background: var(--bg-dark);">
    <div class="container">
      
      <div class="section-header">
        <span class="section-subtitle">Project Execution Photos</span>
        <h2 class="section-title">Categorized Photo Gallery</h2>
        <p class="section-desc">Explore interior finishes, structural engineering, and exterior elevation sections of this project.</p>
      </div>

      <!-- Section Filter Tabs -->
      <div class="detail-gallery-tabs">
        <button class="detail-tab-btn active" data-detail-tab="all">
          <i class="fa-solid fa-border-all"></i> All Project Photos
        </button>
        <button class="detail-tab-btn" data-detail-tab="interior">
          <i class="fa-solid fa-couch"></i> Interior Section
        </button>
        <button class="detail-tab-btn" data-detail-tab="construction">
          <i class="fa-solid fa-helmet-safety"></i> Construction & Structure
        </button>
        <button class="detail-tab-btn" data-detail-tab="elevation">
          <i class="fa-solid fa-building"></i> Facade & Elevation
        </button>
      </div>

      <!-- Gallery Grid View -->
      <div class="detail-gallery-grid" id="detailGalleryGrid">
        <!-- Rendered dynamically via app.js -->
      </div>

    </div>
  </section>

  <!-- Fullscreen Lightbox Image Viewer Overlay -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <button class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Close Lightbox"><i class="fa-solid fa-xmark"></i></button>
    <button class="lightbox-nav-btn prev" id="lightboxPrevBtn" aria-label="Previous Photo"><i class="fa-solid fa-chevron-left"></i></button>
    <button class="lightbox-nav-btn next" id="lightboxNextBtn" aria-label="Next Photo"><i class="fa-solid fa-chevron-right"></i></button>
    
    <div class="lightbox-content">
      <img id="lightboxImg" src="" alt="Full Resolution View">
      <div class="lightbox-caption">
        <span id="lightboxTag" class="lightbox-tag">INTERIOR</span>
        <h4 id="lightboxTitle">Photo Caption</h4>
      </div>
    </div>
  </div>

{{> partials/footer}}
